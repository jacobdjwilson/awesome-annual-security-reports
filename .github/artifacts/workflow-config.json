{
  "workflow": {
    "discovery": {
      "default_limit": 10,
      "max_searches_per_run": 12,
      "max_file_size_mb": 100,
      "pdf_magic_number": "%PDF",
      "push_mode": "missing_conversion",
      "push_batch_limit": 20,
      "max_open_automated_issues": 10,
      "min_search_year": 2008,
      "_max_open_automated_issues_comment": "Hard cap on open issues carrying the report-suggestion or automated-check label that were created by discovery. When open issue count meets or exceeds this limit, the discovery run exits cleanly without creating new issues.",
      "_push_mode_comment": "Controls how the pipeline identifies files to process on a push event. 'git_diff' uses git diff HEAD~1 (fragile with multi-commit pushes and individual-file commits). 'missing_conversion' scans the full PDF folder for any PDF that has no matching Markdown file — this is resilient regardless of how many commits or PDFs were pushed. Set push_batch_limit to cap the number of PDFs processed per push run (0 = unlimited).",
      "rotation_days": {
        "_comment": "How often each priority tier is re-searched. The slot scheduler uses these periods to distribute series evenly across time without any database. Adjust to taste — larger values = less frequent searches per series.",
        "current": 7,
        "stale": 14,
        "old": 30
      },
      "validation_prompt_path": ".github/ai-prompts/report-discovery-validation-prompt.md",
      "feedback_learner_prompt_path": ".github/ai-prompts/discovery-feedback-learner-prompt.md"
    },
    "issue_triage": {
      "labels": {
        "false-positive": { "color": "b60205", "description": "Discovery produced a wrong or unrelated result" },
        "duplicate": { "color": "cfd3d7", "description": "Already in repo or previously reviewed" },
        "mismatch": { "color": "d93f0b", "description": "Correct org but wrong year/edition/category" },
        "accepted": { "color": "0e8a16", "description": "Valid discovery — ready for ingestion" }
      },
      "default_label_color": "e4e669",
      "feedback_artifact_path": ".github/artifacts/discovery-feedback.json"
    },
    "ingest": {
      "trusted_roles": [
        "OWNER",
        "COLLABORATOR",
        "MEMBER"
      ],
      "form_fields": {
        "org": "Organization Name",
        "title": "Report Title",
        "year": "Report Year",
        "url": "Direct PDF URL",
        "category": "Category"
      },
      "table_fields": {
        "org": "Organization",
        "title": "Report",
        "year": "Year",
        "url": "URL",
        "category": "Category"
      }
    },
    "conversion": {
      "system_packages": [
        "poppler-utils",
        "tesseract-ocr",
        "libtesseract-dev",
        "libleptonica-dev"
      ],
      "python_packages": [
        "markitdown[pdf,ocr]",
        "pypdf[crypto]",
        "google-genai",
        "google-ai-generativelanguage",
        "Pillow",
        "pytesseract"
      ],
      "max_age_days": 90,
      "min_text_length": 100,
      "max_pdf_chars": 500000,
      "max_polish_input_chars": 60000,
      "max_fallback_pdf_size_mb": 20,
      "prompt_path": ".github/ai-prompts/pdf-to-markdown-prompt.md",
      "fallback_extraction_prompt_path": ".github/ai-prompts/pdf-fallback-extraction-prompt.md",
      "refresh_batch_limit": 10
    },
    "pull_request": {
      "branch_prefix": "security-reports-update-",
      "labels": [
        "automated",
        "security-reports"
      ],
      "protected_branches": [
        "main",
        "development"
      ],
      "delete_branch": true,
      "single_report_title_template": "Add {organization} {title} ({year})",
      "multiple_report_title_template": "Update Security Reports - {count} Report(s)",
      "max_open_automated_prs": 5,
      "_max_open_automated_prs_comment": "Hard cap on total open automated PRs across all pipelines (security-reports-pipeline + refresh-old-conversions + ingest-suggestion). When this limit is reached, new pipeline runs skip PR creation and exit cleanly. Review and merge/close existing PRs to unblock automation."
    },
    "validation": {
      "min_json_size_bytes": 10,
      "min_markdown_chars": 200,
      "validate_toc": true,
      "verify_conversions": true,
      "duplicate_detection": {
        "min_words_for_comparison": 50,
        "jaccard_similarity_threshold": 0.8
      },
      "link_checker": {
        "max_concurrent_workers": 10
      },
      "issue_domains": {
        "Links": ["dead_link", "missing_readme"],
        "Integrity": ["invalid_pdf", "invalid_md", "oversized_file", "duplicate_pdf", "duplicate_md"],
        "Structure": ["orphaned_pdf", "orphaned_md", "stub_markdown", "year_mismatch", "naming_convention"]
      },
      "category_labels": {
        "orphaned_pdf": "🔴 Orphaned PDFs (no Markdown conversion)",
        "orphaned_md": "🔴 Orphaned Markdowns (no PDF)",
        "stub_markdown": "🔴 Stub / Failed Conversions",
        "invalid_pdf": "🔴 Invalid or Unreadable PDFs",
        "year_mismatch": "🔴 Year Inconsistencies",
        "dead_link": "🔴 Dead External Links",
        "missing_readme": "🔴 Missing README Entries (Active Window)",
        "duplicate_pdf": "🔴 Exact PDF Duplicates (Hash Match)",
        "duplicate_md": "🟡 Potential Content Duplicates (Markdown Similarity)",
        "invalid_md": "🟡 Invalid or Short Markdown Files",
        "naming_convention": "🟡 Filename Convention Violations",
        "oversized_file": "🟡 Oversized Files"
      }
    },
    "analysis": {
      "python_packages": [
        "google-genai",
        "google-ai-generativelanguage"
      ],
      "markdown_lines_for_analysis": 200,
      "markdown_max_chars_for_analysis": 12000,
      "errors_output_file": "analysis_errors.json",
      "summary_prompt_path": ".github/ai-prompts/markdown-summarization-prompt.md",
      "summary_retry_prompt_path": ".github/ai-prompts/markdown-summarization-retry-guidance.md",
      "categorization_prompt_path": ".github/ai-prompts/report-categorization-prompt.md",
      "comment": "markdown_lines_for_analysis and markdown_max_chars_for_analysis both apply — the larger resulting slice is used, capped at markdown_max_chars_for_analysis. This ensures enough context is passed even when early lines are sparse (e.g. heavy TOC). errors_output_file names the structured per-report error log emitted when analysis fails."
    },
    "gating": {
      "monitored_workflows": [
        "security-reports-pipeline.yml",
        "refresh-old-conversions.yml"
      ],
      "monitored_statuses": [
        "in_progress",
        "queued",
        "waiting"
      ]
    },
    "google_search": {
      "python_packages": [
        "requests"
      ]
    },
    "folders": {
      "pdf_source": "Annual Security Reports",
      "markdown_conversions": "Markdown Conversions"
    },
    "virustotal": {
      "api_base_url": "https://www.virustotal.com/api/v3",
      "user_agent": "VirusTotal GitHub Action",
      "large_file_threshold_mb": 32,
      "poll_attempts": 5,
      "poll_backoff_base_seconds": 10,
      "rate_limit_sleep_seconds": 15,
      "skip_on_schedule": false,
      "skip_on_push": false,
      "python_packages": [
        "requests"
      ]
    },
    "lint": {
      "output_file": "lint_output.txt",
      "target_file": "README.md",
      "ignored_rules": [
        "double-link",
        "remark-lint:double-link"
      ],
      "comment": "Configuration for awesome-lint parsing, suppressions, and quality gating. Ignored rules prevent false-positive failures when multiple reports legitimately share an organization landing page."
    }
  }
}